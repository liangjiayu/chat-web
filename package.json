{
  "name": "chat-web",
  "private": true,
  "description": "Chat web app powered by React Router and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "prepare": "husky",
    "db:migrate:local": "wrangler d1 migrations apply chat-web-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chat-web-db --remote",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "4.11.1",
    "isbot": "5.1.32",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@react-router/dev": "7.9.6",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "4.88.0"
  },
  "lint-staged": {
    "*.{ts,tsx,json,css,md}": "oxfmt"
  },
  "packageManager": "pnpm@10.34.4"
}

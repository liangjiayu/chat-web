{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",

    "module": "ES2022",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,

    "types": ["vite/client"],
    "paths": {
      "@/*": ["./app/*"],
      "@contracts/*": ["./contracts/*"]
    },
    "rootDirs": [".", "./.react-router/types"],

    "strict": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "contracts/**/*",
    "workers/**/*",
    "worker-configuration.d.ts"
  ]
}
